# ---- Public site (frontend build args) ----
NEXT_PUBLIC_SITE_URL=https://staging.example.com
NEXT_PUBLIC_CONTACT_EMAIL=sales@osakatool.com
# Keep false on staging. Set true only on https://osakatool.com after launch approval.
SITE_INDEXABLE=false
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ---- API ----
FRONTEND_ORIGIN=https://staging.example.com
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
MONGODB_DB=osaka_tool
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-48-random-characters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=OsakaTool

# ---- IndexNow (production only) ----
PUBLIC_SITE_URL=https://osakatool.com
DEPLOYMENT_ENV=staging
INDEXNOW_ENABLED=false
