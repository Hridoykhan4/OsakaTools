PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/
# Isolated OSAKA TOOL database. The API refuses to start against osaka_toyo.
MONGODB_DB=osaka_tool
# Bootstraps the first "owner" account when no users exist (password: 10+ characters).
ADMIN_USERNAME=owner
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-48-random-characters
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=OsakaTool
FRONTEND_ORIGIN=http://localhost:3000
PUBLIC_SITE_URL=https://osakatool.com
DEPLOYMENT_ENV=development
INDEXNOW_ENABLED=false
